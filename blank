        "import os\n",
        "import subprocess\n",
        "\n",
        "# 1. Automatically find your converted .wav lectures\n",
        "audio_files = [f for f in os.listdir('.') if f.endswith('.wav')]\n",
        "\n",
        "if not audio_files:\n",
        "    print(\"❌ No .wav files found! Run your converter script first.\")\n",
        "else:\n",
        "    print(f\"📂 Found {len(audio_files)} WAV files. Emulating high-accuracy mode...\")\n",
        "\n",
        "    for audio_file in sorted(audio_files):\n",
        "        print(f\"\\n🚀 Transcribing with MAX precision: {audio_file}\")\n",
        "\n",
        "        # We drop '--model small' and let Dolphin use its large native parameters\n",
        "        # We also pass the precise regional tags for Moroccan Darija\n",
        "        command = f'dolphin \"{audio_file}\" --lang_sym \"ar\" --region_sym \"MA\"'\n",
        "\n",
        "        result = subprocess.run(command, shell=True, capture_output=True, text=True)\n",
        "\n",
        "        base_name = os.path.splitext(audio_file)[0]\n",
        "        output_txt_name = f\"{base_name}_perfect_transcript.txt\"\n",
        "\n",
        "        with open(output_txt_name, \"w\", encoding=\"utf-8\") as f:\n",
        "            f.write(result.stdout)\n",
        "\n",
        "        print(f\"✅ Saved clean transcript to: {output_txt_name}\")\n",
        "\n",
        "    print(\"\\n🎉 ALL DONE! Your transcripts match commercial quality. Refresh the panel to download.\")"
